{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "All Tests",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "${workspaceRoot}/node_modules/jest/bin/jest.js",
                "--runInBand",
                "--config=jest.config.js"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            }
        },
        {
            "name": "Debug Tests",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "${workspaceRoot}/node_modules/jest/bin/jest.js",
                "--testMatch=**/*.test.jest.ts",
                "--verbose",
                "--colors",
                "--runInBand",
                "--reporters=default",
                "--config=jest.config.js"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            }
        },
        {
            "name": "Board Tests",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "${workspaceRoot}/node_modules/jest/bin/jest.js",
                "--testMatch=**/board.test.jest.ts",
                "--verbose",
                "--colors",
                "--runInBand",
                "--reporters=default",
                "--config=jest.config.js"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules"
            }
        },
        {
            "name": "Experiment",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "${workspaceRoot}/node_modules/jest/bin/jest.js",
                "--testMatch=**/exp.jest.ts",
                "--testPathIgnorePatterns=[]",
                "--runInBand",
                "--config=jest.config.js"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "env": {
                "NODE_OPTIONS": "--experimental-vm-modules",
                "KEEP_SAMPLES": "true"
            }
        }
    ]
}